# A integração Neon na Vercel preenche DATABASE_URL automaticamente.
# Para desenvolvimento, copie a conexão de um banco/branch de testes para .env.
# Também aceita POSTGRES_URL quando esse for o nome criado pela integração.
DATABASE_URL=

# Obrigatório em produção: gere com o comando abaixo e guarde em segredo.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Informe este código apenas ao cadastrar/redefinir a primeira senha da equipe.
SETUP_KEY=

# Usado somente ao executar npm run dev / npm start fora da Vercel.
PORT=3000
